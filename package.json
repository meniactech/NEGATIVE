	"version": "0.1.0",
	"license": "MIT",
	"description": "NEGATIVE — film-style photo looks, designed on one image, applied to a folder.",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 8084",
		"build": "vite build",
		"start": "HOST=127.0.0.1 PORT=8084 node build",
		"preview": "vite preview --host 127.0.0.1 --port 8084",
